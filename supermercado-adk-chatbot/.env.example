# Copie este archivo a .env (ignorado por Git) y complete los valores reales.
# Nunca confirme .env ni comparta la clave en capturas, informes o logs.
#
#   cp .env.example .env
#   chmod 600 .env
#   set -a; source .env; set +a
#
# ADK Java no carga .env por sí solo: las variables deben exportarse en la
# misma terminal que ejecuta el servidor web de ADK.

# Obligatoria. Clave de la API de Gemini.
GEMINI_API_KEY=replace-me

# Alternativa admitida por algunas versiones de ADK. Si se define, se usa solo
# cuando GEMINI_API_KEY está ausente o vacía.
# GOOGLE_API_KEY=replace-me

# Modelo por defecto. Sobrescriba aquí si su cuenta usa otro modelo disponible.
ADK_MODEL=gemini-2.5-flash

# Endpoint MCP del servidor de supermercado. Debe ser loopback.
MCP_SERVER_URL=http://127.0.0.1:8089/mcp
